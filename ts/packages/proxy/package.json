{
  "name": "tokimeter",
  "version": "0.6.0",
  "description": "Local-first usage & cost meter for AI coding agents (Claude Code, Codex, Cursor, Grok Build, Hermes, opencode, Cline, Copilot CLI). Inline status-line HUDs, zero-setup reports, 5h-window limits, budgets — no telemetry.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tokimeter-proxy": "src/server.js",
    "tokimeter": "src/cli.js",
    "tm": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "tokimeter": "node src/cli.js",
    "tm": "node src/cli.js",
    "smoke": "node src/cli.js --version && node src/cli.js advisor-test claude sonnet hi",
    "pack:local": "npm pack",
    "prepublishOnly": "node ../../../scripts/privacy-check.mjs --prepublish",
    "prepack": "rm -rf src/core && cp -R ../core/src src/core",
    "postpack": "rm -rf src/core"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "author": {
    "name": "ToshiPepe",
    "url": "https://github.com/toshipepe"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toshipepe/tokimeter.git",
    "directory": "ts/packages/proxy"
  },
  "homepage": "https://tokimeter.com",
  "bugs": {
    "url": "https://github.com/toshipepe/tokimeter/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "cline",
    "copilot-cli",
    "grok",
    "llm",
    "cost-tracking",
    "token-usage",
    "finops",
    "anthropic",
    "openai",
    "cli"
  ]
}
